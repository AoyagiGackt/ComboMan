{
  "_comment": "バグ探しの自動テストプレイの手順（BugHunt プロジェクトを実行するか、Engine.exe を --bug-hunt 付きで起動すると、この順にゲームを自分で遊ぶ）。チュートリアル、1面から最後のステージまで、いろいろな遊び方で回してから近道（F5）でクリアし、続けてラスボス戦をしてエンディングまで行く。遊んでいる間、ゲーム側が見張っておかしな所（扉の条件が成立しない・届かない所の敵・無効中なのに生きている敵・生き返った敵・先へ進めない・床抜け・固まりかけ など）を見つけたら、止めずに記録して先へ進む。結果は smoke_test フォルダの result_～.txt に、見つけたおかしな所の一覧と一緒に出る。seed=ランダム操作の種（0なら毎回変える。報告に出た種を入れると同じ動きをもう一度試せる）。speed=1回描くごとにゲームを何回進めるか（1〜16。大きいほど速いが画面はとびとびになる。--realtime を付けた時はふだんの速さ）。keepPlayerAlive=true なら体力が半分を切ったら全快させて最後まで回る（ダメージ自体は受ける）。手順の書き方は smoke_test.json と同じで、ほかに enterNextStage=今のランで次のステージへ直接入る（最後のステージの後はラスボス戦） enterTutorial=マップの入口と同じ準備をしてチュートリアルへ入る（抜けると持ち物は入る前に戻る） grantBossWeapon=ボスを倒さずにボスの武器を渡す（weapon で種類、無ければ今のボスの枠と違う種類。埋まっていれば主軸を選ぶ画面が出る） waitSettled=どの画面でもよいので切り替えが落ち着くまで待つ random の hold=ずっと押し続けるキー chance=それぞれのキーを押す確率 interval=押し直す間隔 expectProgress=この間は右へ進めるはず（進めなければ知らせる） sameStage=入ったステージの中だけの手順（自分でクリアした・やられてリトライした・人が操作して画面が変わった等の時は飛ばして次のステージへ進む）。キー: 1/2/3=武器の持ち替え 4=ボスの枠 V=味方のボスを呼ぶ（ボスの武器どうしの合体がある時） A/D=左右 W=ジャンプ S=下 L=攻撃 K=射撃 Space=固有技 I=回避 J=奪う R=覚醒 F=フィニッシャー G=銃切替 C=ワープ U=ラスボス戦のジャンプ",
  "seed": 0,
  "keepPlayerAlive": true,
  "speed": 4,
  "settleSeconds": 0.5,
  "steps": [
    { "action": "mark", "text": "タイトルから NEW GAME" },
    { "action": "waitScene", "scene": "TITLE", "timeout": 30 },
    { "action": "wait", "seconds": 1 },
    { "action": "pressUntilScene", "key": "Enter", "scene": "MAP", "interval": 0.6, "timeout": 20 },
    { "action": "mark", "text": "チュートリアル" },
    { "action": "waitSettled", "timeout": 60 },
    { "action": "wait", "seconds": 3 },
    { "action": "enterTutorial" },
    { "action": "waitScene", "scene": "GAMEPLAY", "timeout": 30 },
    { "action": "wait", "seconds": 4, "sameStage": true },
    { "action": "mark", "text": "チュートリアル 右へ進みながら戦い、武器を奪って持ち替える", "sameStage": true },
    { "action": "random", "hold": ["D"], "keys": ["L", "L", "W", "K", "I", "Space", "J", "J", "1", "2", "3"], "chance": 0.4, "interval": 0.3, "seconds": 60, "expectProgress": true, "sameStage": true },
    { "action": "mark", "text": "チュートリアル 何でも押す（合体と砕けを起こしやすいように攻撃と奪うを多めに）", "sameStage": true },
    { "action": "random", "keys": ["A", "D", "W", "S", "L", "L", "L", "K", "Space", "I", "J", "J", "R", "F", "1", "2", "3"], "seconds": 20, "sameStage": true },
    { "action": "mark", "text": "チュートリアル 最後にもう一度右へ進む", "sameStage": true },
    { "action": "random", "hold": ["D"], "keys": ["L", "W", "J"], "chance": 0.4, "interval": 0.3, "seconds": 20, "expectProgress": true, "sameStage": true },
    { "action": "mark", "text": "チュートリアル 近道でクリアしてマップへ", "sameStage": true },
    { "action": "press", "key": "F5", "sameStage": true },
    { "action": "waitSceneChange", "timeout": 60, "sameStage": true },
    { "action": "waitScene", "scene": "MAP", "timeout": 60 },
    {
      "action": "repeat",
      "count": 6,
      "steps": [
        { "action": "mark", "text": "次のステージへ" },
        { "action": "waitSettled", "timeout": 60 },
        { "action": "wait", "seconds": 3 },
        { "action": "enterNextStage" },
        { "action": "waitScene", "scene": "GAMEPLAY", "timeout": 30 },
        { "action": "wait", "seconds": 4, "sameStage": true },
        { "action": "mark", "text": "ボスの武器を渡して、ボスの枠で戦う（2本目からは主軸を選ぶ画面を決定で閉じる）", "sameStage": true },
        { "action": "grantBossWeapon", "sameStage": true },
        { "action": "wait", "seconds": 0.5, "sameStage": true },
        { "action": "press", "key": "Enter", "sameStage": true },
        { "action": "wait", "seconds": 0.5, "sameStage": true },
        { "action": "press", "key": "4", "sameStage": true },
        { "action": "press", "key": "V", "sameStage": true },
        { "action": "mark", "text": "右へ進みながら戦う", "sameStage": true },
        { "action": "random", "hold": ["D"], "keys": ["L", "L", "W", "K", "I", "Space", "J", "1", "4"], "chance": 0.4, "interval": 0.3, "seconds": 45, "expectProgress": true, "sameStage": true },
        { "action": "mark", "text": "何でも押す", "sameStage": true },
        { "action": "random", "keys": ["A", "D", "W", "S", "L", "K", "Space", "I", "J", "R", "F", "G", "C"], "seconds": 15, "sameStage": true },
        { "action": "mark", "text": "ジャンプと回避ばかり", "sameStage": true },
        { "action": "random", "hold": ["D"], "keys": ["W", "I", "S", "L"], "chance": 0.5, "interval": 0.2, "seconds": 10, "expectProgress": true, "sameStage": true },
        { "action": "mark", "text": "銃ばかり", "sameStage": true },
        { "action": "random", "keys": ["K", "K", "G", "W", "A", "D"], "chance": 0.5, "interval": 0.25, "seconds": 10, "sameStage": true },
        { "action": "mark", "text": "行ったり来たりしながら攻撃", "sameStage": true },
        { "action": "random", "keys": ["A", "D", "L", "S"], "chance": 0.5, "interval": 0.5, "seconds": 8, "sameStage": true },
        { "action": "mark", "text": "最後にもう一度右へ進む", "sameStage": true },
        { "action": "random", "hold": ["D"], "keys": ["L", "W", "J"], "chance": 0.4, "interval": 0.3, "seconds": 20, "expectProgress": true, "sameStage": true },
        { "action": "mark", "text": "近道でクリアして次へ", "sameStage": true },
        { "action": "press", "key": "F5", "sameStage": true },
        { "action": "waitSceneChange", "timeout": 60, "sameStage": true }
      ]
    },
    { "action": "mark", "text": "ラスボス戦" },
    { "action": "waitSettled", "timeout": 60 },
    { "action": "waitScene", "scene": "GAMEPLAY", "timeout": 60 },
    { "action": "wait", "seconds": 8 },
    { "action": "mark", "text": "ラスボス戦でいろいろ操作する" },
    { "action": "random", "keys": ["W", "A", "S", "D", "U", "L", "L", "K", "I", "Space", "R", "F"], "chance": 0.4, "interval": 0.3, "seconds": 40 },
    { "action": "mark", "text": "ラスボス戦で回避ばかり" },
    { "action": "random", "keys": ["A", "D", "W", "S", "I", "U"], "chance": 0.5, "interval": 0.2, "seconds": 10 },
    { "action": "mark", "text": "近道でクリアしてエンディングへ" },
    { "action": "press", "key": "F5" },
    { "action": "waitScene", "scene": "CLEAR", "timeout": 90 },
    { "action": "wait", "seconds": 3 },
    { "action": "mark", "text": "最後まで回りました" }
  ]
}
